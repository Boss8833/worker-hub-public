# Copy to .env (or run: npm run gen-key) - NEVER commit .env
PORT=8787
HOST=127.0.0.1
DATA_DIR=./data
# 32 random bytes, base64. Generate with: npm run gen-key
WORKER_HUB_ENCRYPTION_KEY=
# Optional: require this token in the X-Access-Token header for every /api call except /api/health
WORKER_HUB_ACCESS_TOKEN=
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
